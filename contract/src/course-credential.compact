/*
 * Course Completion Verification
 *
 * A single-credential registry that lets an issuer publish a course completion
 * credential for a student, and lets a verifier confirm that the credential is
 * valid without the student's identity ever being written to the public ledger.
 *
 * Privacy model:
 *  - The course name and the issuer's public key are public; neither is private
 *    student information.
 *  - The student's identifier is never stored directly. Instead the ledger holds
 *    a Pedersen-style commitment computed as persistentCommit(sha256(identifier),
 *    salt). The random salt is kept secret (shared only with the student), so the
 *    commitment hides the identifier even against offline guessing.
 *  - To verify, the student reveals the identifier and the salt directly to a
 *    chosen verifier. The verifier recomputes the commitment locally through the
 *    exported `commit` pure circuit and compares it to the on-chain value.
 */

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  VACANT,
  ISSUED
}

export ledger state: State;

export ledger course: Maybe<Opaque<"string">>;

export ledger studentCommitment: Maybe<Bytes<32>>;

export ledger sequence: Counter;

export ledger issuer: Bytes<32>;

constructor() {
  state = State.VACANT;
  course = none<Opaque<"string">>();
  studentCommitment = none<Bytes<32>>();
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "cred:pk:"), sequence, sk]);
}

export circuit commit(studentId: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(studentId, salt);
}

export circuit issueCredential(courseName: Opaque<"string">, studentId: Bytes<32>, salt: Bytes<32>): [] {
  assert(state == State.VACANT, "Attempted to issue a credential while one is already active");
  issuer = disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>));
  course = disclose(some<Opaque<"string">>(courseName));
  studentCommitment = some<Bytes<32>>(commit(studentId, salt));
  state = State.ISSUED;
}

export circuit revokeCredential(): Opaque<"string"> {
  assert(state == State.ISSUED, "Attempted to revoke a credential when none is active");
  assert(issuer == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Attempted to revoke a credential, but not the current issuer");
  const formerCourse = course.value;
  state = State.VACANT;
  sequence.increment(1);
  course = none<Opaque<"string">>();
  studentCommitment = none<Bytes<32>>();
  return formerCourse;
}
